<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GTBrasil.Models"
             x:Class="GTBrasil.MainPage"
             x:DataType="local:MainPage"
             xmlns:local="clr-namespace:GTBrasil"
             Shell.NavBarIsVisible="False"
             Background="#080D18">
    <Grid RowDefinitions="*">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,20,20,28" Spacing="22">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Text="GT / BRASIL"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#F4F7FC"
                           CharacterSpacing="1.5" />
                    <Label Grid.Row="1"
                           Text="GARAGE EDITION"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#39D8E8" />
                    <Border Grid.Column="1"
                            Grid.RowSpan="2"
                            Padding="12,8"
                            VerticalOptions="Center"
                            Background="#142238"
                            Stroke="#263B57"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">
                        <Label Text="{Binding CashDisplay}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#F5C451"
                               AutomationId="cash-balance" />
                    </Border>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsClassifiedsVisible}" Spacing="16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="CLASSIFICADOS"
                               FontSize="22"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="#F4F7FC" />
                        <Label Text="CLÁSSICOS À VENDA. ESCOLHA O SEU."
                               FontSize="11"
                               CharacterSpacing="0.5"
                               TextColor="#A8B6C9" />
                    </VerticalStackLayout>

                    <Button Text="VOLTAR À GARAGEM"
                            Clicked="OnGarageClicked"
                            Background="#183148"
                            TextColor="#F4F7FC"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="7"
                            HeightRequest="42"
                            AutomationId="back-to-garage-button" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cars}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Car">
                                <Border Padding="14"
                                        Background="#111B2B"
                                        Stroke="#263B57"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        AutomationId="{Binding AutomationId}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="#39D8E8" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCarTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                                        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Name}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="#F4F7FC" />
                                                <Label Text="{Binding Category}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       CharacterSpacing="1"
                                                       TextColor="#39D8E8" />
                                            </VerticalStackLayout>
                                            <Image Grid.Column="1"
                                                   Source="{Binding Image}"
                                                   WidthRequest="142"
                                                   HeightRequest="78"
                                                   Aspect="AspectFit"
                                                   SemanticProperties.Description="{Binding ImageDescription}" />
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              Grid.ColumnSpan="2"
                                              ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="16"
                                              RowSpacing="8">
                                            <VerticalStackLayout Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="POTÊNCIA" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                                    <Label Grid.Column="1" Text="{Binding Power, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding PowerProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="FRENAGEM" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                                    <Label Grid.Column="1" Text="{Binding Braking, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding BrakingProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Row="1" Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="DIRIGIBILIDADE" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                                    <Label Grid.Column="1" Text="{Binding Handling, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding HandlingProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="PNEUS" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                                    <Label Grid.Column="1" Text="{Binding Tires, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding TiresProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Label Grid.Row="2"
                                               Text="{Binding Price, StringFormat='PREÇO  R$ {0:N0}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.5"
                                               TextColor="#F5C451"
                                               VerticalOptions="Center" />
                                        <Label Grid.Row="2"
                                               Grid.Column="1"
                                               Text="NA GARAGEM"
                                               IsVisible="{Binding IsOwned}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#72E0A2"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Padding="14"
                            Background="#142238"
                            Stroke="#263B57"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding SelectionSummary}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#F4F7FC"
                                   AutomationId="selection-summary" />
                            <Label Text="{Binding Notice}"
                                   IsVisible="{Binding HasNotice}"
                                   FontSize="12"
                                   TextColor="#FF9B86" />
                            <Button Text="{Binding PurchaseButtonText}"
                                    Clicked="OnPurchaseClicked"
                                    IsEnabled="{Binding HasSelectedCar}"
                                    Background="#F5C451"
                                    TextColor="#111827"
                                    FontAttributes="Bold"
                                    CharacterSpacing="0.5"
                                    CornerRadius="7"
                                    HeightRequest="48"
                                    AutomationId="purchase-button" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsGarageVisible}" Spacing="16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="GARAGEM PRINCIPAL"
                               FontSize="22"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="#F4F7FC" />
                        <Label Text="{Binding GarageSubtitle}"
                               FontSize="11"
                               CharacterSpacing="0.5"
                               TextColor="#A8B6C9" />
                    </VerticalStackLayout>

                    <Border Padding="16"
                            Background="#111B2B"
                            Stroke="#263B57"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            IsVisible="{Binding HasGarageCar}"
                            AutomationId="garage-car-card">
                        <VerticalStackLayout Spacing="13">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding GarageCar.Name}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#F4F7FC" />
                                <Label Grid.Column="1"
                                       Text="ADQUIRIDO"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#72E0A2"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Image Source="{Binding GarageCar.Image}"
                                   HeightRequest="142"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="{Binding GarageCar.ImageDescription}"
                                   AutomationId="garage-car-image" />
                            <Label Text="{Binding GarageCar.Category}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#39D8E8" />

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="18"
                                  RowSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="POTÊNCIA" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Power, StringFormat='{0}/10'}" FontSize="11" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.PowerProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="6" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="FRENAGEM" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Braking, StringFormat='{0}/10'}" FontSize="11" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.BrakingProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="6" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="DIRIGIBILIDADE" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Handling, StringFormat='{0}/10'}" FontSize="11" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.HandlingProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="6" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="PNEUS" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Tires, StringFormat='{0}/10'}" FontSize="11" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.TiresProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="6" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="22"
                            IsVisible="{Binding IsEmptyGarageVisible}"
                            Background="#111B2B"
                            Stroke="#263B57"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            AutomationId="empty-garage">
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="GARAGEM VAZIA"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="#F4F7FC"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="ESCOLHA SEU PRIMEIRO CLÁSSICO NOS CLASSIFICADOS."
                                   FontSize="11"
                                   CharacterSpacing="0.5"
                                   TextColor="#A8B6C9"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="SELECIONE UMA ATIVIDADE"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="#A8B6C9" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="{Binding RaceButtonText}"
                                Clicked="OnRaceClicked"
                                IsEnabled="{Binding HasGarageCar}"
                                Background="#183148"
                                TextColor="#39D8E8"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="7"
                                HeightRequest="62"
                                AutomationId="race-button" />
                        <Button Grid.Column="1"
                                Text="AUTO PEÇAS&#10;EM BREVE"
                                IsEnabled="False"
                                Background="#183148"
                                TextColor="#B6C3D3"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="7"
                                HeightRequest="62"
                                AutomationId="auto-parts-button" />
                        <Button Grid.Column="2"
                                Text="CLASSIFICADOS"
                                Clicked="OnClassifiedsClicked"
                                Background="#F5C451"
                                TextColor="#111827"
                                FontSize="11"
                                FontAttributes="Bold"
                                CornerRadius="7"
                                HeightRequest="62"
                                AutomationId="shop-button" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsRaceVisible}" Spacing="16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="CORRIDA"
                               FontSize="22"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="#F4F7FC" />
                        <Label Text="AUTÓDROMO JOSÉ CARLOS PACE  •  INTERLAGOS"
                               FontSize="11"
                               CharacterSpacing="0.5"
                               TextColor="#A8B6C9" />
                    </VerticalStackLayout>

                    <Button Text="VOLTAR À GARAGEM"
                            Clicked="OnGarageClicked"
                            Background="#183148"
                            TextColor="#F4F7FC"
                            FontSize="11"
                            FontAttributes="Bold"
                            CornerRadius="7"
                            HeightRequest="42"
                            AutomationId="back-to-garage-from-race-button" />

                    <Border Padding="12"
                            Background="#111B2B"
                            Stroke="#263B57"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="CIRCUITO DE INTERLAGOS"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.5"
                                       TextColor="#F4F7FC" />
                                <Label Grid.Column="1"
                                       Text="SÃO PAULO / BR"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="#39D8E8"
                                       VerticalOptions="Center" />
                            </Grid>

                            <GraphicsView x:Name="InterlagosTrackView"
                                          HeightRequest="300"
                                          Background="#0B1422"
                                          AutomationId="interlagos-track" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding CurrentLapDisplay}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#F4F7FC"
                                       AutomationId="race-lap" />
                                <Label Grid.Column="1"
                                       Text="{Binding RacePaceDisplay}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#F5C451"
                                       AutomationId="race-pace" />
                            </Grid>
                            <Label Text="S DO SENNA  •  RETA OPOSTA  •  DESCIDA DO LAGO  •  FERRADURA  •  PINHEIRINHO  •  BICO DE PATO  •  MERGULHO  •  JUNÇÃO"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.4"
                                   TextColor="#A8B6C9" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="14"
                            Background="#111B2B"
                            Stroke="#263B57"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding GarageCar.Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#F4F7FC" />
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="16"
                                  RowSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="POTÊNCIA" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Power, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.PowerProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="FRENAGEM" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Braking, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.BrakingProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="DIRIGIBILIDADE" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Handling, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.HandlingProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="PNEUS" FontSize="10" FontAttributes="Bold" TextColor="#B6C3D3" />
                                        <Label Grid.Column="1" Text="{Binding GarageCar.Tires, StringFormat='{0}/10'}" FontSize="10" FontAttributes="Bold" TextColor="#F5C451" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding GarageCar.TiresProgress}" ProgressColor="#39D8E8" Background="#27364B" HeightRequest="5" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding RacePaceWeightsDisplay}"
                                   FontSize="9"
                                   CharacterSpacing="0.2"
                                   TextColor="#A8B6C9" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
